# Route.it Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# NEVER commit real secrets or API tokens to version control.

# Application & API Settings
ROUTEIT_ENV=development
ROUTEIT_API_HOST=0.0.0.0
ROUTEIT_API_PORT=8000
ROUTEIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Uses built-in transactional SQLite store by default for local/zero-config startup;
# Set ROUTEIT_POSTGRES_DSN for PostgreSQL + PostGIS production deployment.
ROUTEIT_SQLITE_PATH=./data/routeit.db
ROUTEIT_POSTGRES_DSN=postgresql://routeit:routeit_dev_password@localhost:5432/routeit

# Worker & Optimization Defaults
ROUTEIT_WORKER_CONCURRENCY=2
ROUTEIT_DEFAULT_TIMEZONE=Asia/Kolkata

# Map & Geocoding Provider Configuration (Optional)
# Browser uses public URL-restricted token for temporary autocomplete/reverse-geocoding.
# Server uses secret token ONLY when permanent geocoding storage is explicitly enabled.
# When left blank, Route.it uses its built-in OpenStreetMap/MapLibre vector style & local urban gazetteer.
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_MAP_TILE_STYLE_URL=https://demotiles.maplibre.org/style.json
MAPBOX_SECRET_TOKEN=
MAPBOX_PERMANENT_GEOCODING_ENABLED=false
